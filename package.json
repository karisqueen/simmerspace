{
  "name": "simmerspace",
  "version": "0.7.0",
  "private": true,
  "description": "A visual Sims 4 mods and custom content manager prototype.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.simmerspace.desktop",
    "productName": "SimmerSpace",
    "electronVersion": "42.11.14",
    "npmRebuild": false,
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "mods-manager.css",
      "app.js",
      "mods-manager.js",
      "folders.js",
      "demo-data.js",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
