# SimmerSpace integration settings: copy the lines you need into your shell or a local, untracked file.
# Electron does not read .env files by itself. Set these as environment variables before `pnpm start`
# (PowerShell: $env:CURSEFORGE_API_KEY = '...' with single quotes, because keys contain $), or use simmerspace.config.json instead (see docs).
# Never commit real values. .env and .env.* are ignored by git.

# CurseForge for Studios API key, exactly as shown in the CurseForge developer console (no "Bearer" prefix).
CURSEFORGE_API_KEY=your-curseforge-api-key
# Optional. Defaults to https://api.curseforge.com
CURSEFORGE_API_BASE_URL=
# Optional. Use the Supabase Edge Function proxy instead of a key on this PC (see docs/CURSEFORGE-SETUP.md).
CURSEFORGE_PROXY_URL=
# Optional. Normally discovered from the API (slug "sims4").
CURSEFORGE_GAME_ID=

# SimmerSpace accounts (Supabase). Both values are public by design; data is protected by row level security.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Shows the developer diagnostics section in Settings.
SIMMERSPACE_DEV=
